rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Registros de ingreso (socios y no socios). La app no tiene login, así que
    // cualquiera con la app puede leer y escribir; se valida la forma de los datos.
    match /records/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'tipo', 'name', 'date', 'ts'])
        && request.resource.data.id == id
        && request.resource.data.tipo in ['socio', 'no_socio']
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 500
        && request.resource.data.date.matches('^[0-9]{2}-[0-9]{2}-[0-9]{4}$');
      allow delete: if true;
    }

    // Índice de días con registros (para "Ver Archivos").
    match /days/{date} {
      allow read: if true;
      allow write: if date.matches('^[0-9]{2}-[0-9]{2}-[0-9]{4}$');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
