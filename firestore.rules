rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administradores: pueden todo. Esta lista tiene que coincidir con src/config/admins.js.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'juventud@bethilel.org.ar',
          'gan@bethilel.org.ar',
          'ligdol@bethilel.org.ar',
          'tikva@bethilel.org.ar',
          'ramah@bethilel.org.ar',
          'maale@bethilel.org.ar'
        ];
    }

    // Usuario de grupo activo: solo ve el presentismo de su grupo.
    function myUser() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function myGroup() {
      return myUser().group;
    }

    function isGroupUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && myUser().role == 'grupo';
    }

    function validDate(d) {
      return d is string && d.matches('^[0-9]{2}-[0-9]{2}-[0-9]{4}$');
    }

    // Registros de ingreso (socios y no socios, con montos): solo admins.
    match /records/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.id == id
        && request.resource.data.tipo in ['socio', 'no_socio']
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 500
        && validDate(request.resource.data.date);
    }

    // Índice de días con registros (para "Ver Archivos"): solo admins.
    match /days/{date} {
      allow read, write: if isAdmin() && validDate(date);
    }

    // Asistencia por persona: admins todo; cada grupo lee solo lo suyo.
    match /asistencias/{id} {
      allow read: if isAdmin() || (isGroupUser() && resource.data.group == myGroup());
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.group is string
        && validDate(request.resource.data.date);
    }

    // Usuarios de grupo: los admins los administran; cada uno puede leer el suyo.
    match /usuarios/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
